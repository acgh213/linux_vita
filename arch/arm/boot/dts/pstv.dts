// SPDX-License-Identifier: GPL-2.0
/*
 * Device Tree Source for the PlayStation TV
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/vita-pervasive.h>
#include "vita.dtsi"

/ {
	chosen {
		bootargs = "earlyprintk keep_bootcon console=ttyS0,115200 console=tty0";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * CDRAM: the bare-metal loader already lit this up (smc 0x117)
		 * and IFTU bus 1 plane A/B are already scanning out of
		 * 0x20000000 in the "a8b8g8r8" / IFTU 0x10 (BGRX8888) format
		 * at 1280x720, stride 5120 bytes -- see
		 * lab/gpu-re/IFTU-VBLANK-FINDING-2026-08-30.md for the
		 * register-level verification. no-map: this is not normal
		 * System RAM (it lives far below the &memory node's base at
		 * 0x40200000) and the buddy allocator must never touch it.
		 * Only the low 3,686,400 bytes are the live framebuffer; the
		 * reservation covers the full 128 MiB CDRAM window so a
		 * future second (flip) buffer has somewhere safe to live.
		 */
		hdmi_fb: framebuffer@20000000 {
			reg = <0x20000000 0x8000000>; /* 128 MiB */
			no-map;
		};
	};
};

/*
 * PSTV HDMI display controller (IFTU bus 1 + control block). The loader has
 * already set the mode, clocks, and DSI/ADV7533 bring-up -- this node only
 * describes what Linux inherits. Bus 0 (OLED/LCD path) is clock-gated on
 * PSTV and MUST NOT be probed (reads SIGBUS); this SoC only exposes bus 1
 * here for that reason.
 */
&soc {
	iftu1: display@e5030000 {
		compatible = "vita,iftu";
		reg = <0xe5030000 0x2000>,  /* plane A/B registers, bus 1 */
		      <0xe5032000 0x1000>, /* control registers, bus 1   */
		      <0xe5060000 0x1000>; /* DSI bus-1 block (vblank IRQ) */
		reg-names = "planes", "control", "dsi";
		/*
		 * DSI bus-1 vblank interrupt. VitaOS GIC code 210 (SceDsi1 /
		 * SceDisplayVbStartHDMI) maps to GIC_SPI 178 = hardware IRQ
		 * 210 (GIC_SPI N = IRQ N+32; see vita.dtsi SDIF comments).
		 * The loader already arms the DSI-side mask (intr enable
		 * +0x54 = 2); Linux must claim the line and ack via +0x50.
		 */
		interrupts = <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>;
		memory-region = <&hdmi_fb>;

		/*
		 * Inherited mode -- measured on hardware, NOT the loader's
		 * nominal 720p60 table entry. See
		 * lab/gpu-re/VBLANK-52HZ-RESOLVED-2026-08-30.md: the DSI
		 * pixel clock is running at 20/23 of the nominal 74.1758 MHz
		 * (root cause TBD -- table divider values vs. this SoC
		 * revision), giving 750 lines * 1650 px at ~64.47 MHz =
		 * 52.099 Hz measured on a 60 s precision count. Advertise the
		 * real number; do not claim 60 Hz here.
		 */
		width = <1280>;
		height = <720>;
		stride = <5120>;
		format = "a8b8g8r8";

		status = "okay";
	};
};

&i2c0 {
	status = "okay";
};

/* GPIO1 pin 3 is the external Type-A port's VBUS enable on this board. */
&gpio1 {
	status = "okay";
};

/* Bus 0 is the external Type-A port; bus 2 carries internal Realtek Ethernet.
 * Bus 1 has no identified PSTV attachment, and all-bus 0x7 remains unvalidated.
 */
&pervasive_clk {
	vita,usb-hostmode-mask = <0x5>;
	vita,clock-gate-indices = <VITA_PCLK_DSI1 VITA_PCLK_GPIO
				    VITA_PCLK_SPI0 VITA_PCLK_UART0
				    VITA_PCLK_MSIF>;
};

/* I2C1 has ADV7533 HDMI transmitter (0x38, 0x3D-0x3F) — disabled until
 * a driver is written. Also has motion sensor (0x0C) and LCD brightness (0x64). */

/* SDIF0 = eMMC, SDIF2 = WLAN/BT (SD8787 via SDIO) */
&sdif0 {
	status = "okay";
};

/* SDIF1 (game card) and SDIF3 (microSD/SD2Vita) disabled --
 * no cards present, and polling creates log spam */

&sdif2 {
	status = "okay";
};

/* USB host (EHCI-only; see the OHCI note in vita.dtsi).  Bus 0 is the
 * external Type-A port and bus 2 carries the internal Realtek 0bda:8152
 * USB-Ethernet adapter; both were identified on hardware in 2026-08.  Bus 1
 * has no identified attachment and is deliberately disabled on PSTV.
 */
&ehci0 {
	status = "okay";
};

/* The PSTV (Dolce) has no touch panel. Probing the syscon touchscreen
 * on it issues Ernie touch commands with no hardware behind them,
 * which wedges the console during boot (observed 2026-08-19, c17).
 */
&syscon_ts {
	status = "disabled";
};

&ehci1 {
	status = "disabled";
};

&ehci2 {
	status = "okay";
};

/ {
	/* The external Type-A socket is on Sony bus 0 (&ehci0).  It stays
	 * dead until both the Dolce 5 V rail and GPIO1 pin 3 are asserted,
	 * which this node's driver does once &ehci0 has finished probing.
	 */
	usb0_power: usb0-power {
		compatible = "vita,dolce-usb-power";
		vita,syscon = <&syscon>;
		vita,ehci = <&ehci0>;
		enable-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
	};
};
