/*
 * Device Tree Source for the PlayStation TV
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/vita-pervasive.h>
#include "vita.dtsi"

/ {
	chosen {
		bootargs = "earlyprintk keep_bootcon console=tty0 console=ttyS0,115200";

		framebuffer0: framebuffer@20000000 {
			compatible = "simple-framebuffer";
			reg = <0x20000000 (1280*720*4)>;
			width = <1280>;
			height = <720>;
			stride = <(1280*4)>;
			format = "a8b8g8r8";
			status = "okay";
		};
	};
};

&i2c0 {
	status = "okay";
};

/* I2C1 has ADV7533 HDMI transmitter (0x38, 0x3D-0x3F) — disabled until
 * a driver is written. Also has motion sensor (0x0C) and LCD brightness (0x64). */

/* SDIF0 = eMMC, SDIF2 = WLAN/BT (SD8787 via SDIO) */
&sdif0 {
	status = "okay";
};

/* SDIF1 (game card) and SDIF3 (microSD/SD2Vita) disabled --
 * no cards present, and polling creates log spam */

&sdif2 {
	status = "okay";
};

/* USB host (EHCI-only; see the OHCI note in vita.dtsi).  All three buses
 * enabled for bring-up: the internal SMSC USB-Ethernet and the Type-A
 * port are believed to sit on bus 0 or bus 1 (neither had ever been
 * driven before 2026-08-19), bus 2 is the OTG bus the 2026-08-18
 * EHCI/OHCI campaign studied. */
&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};
