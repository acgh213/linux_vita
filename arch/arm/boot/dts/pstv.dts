// SPDX-License-Identifier: GPL-2.0
/*
 * Device Tree Source for the PlayStation TV
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/vita-pervasive.h>
#include "vita.dtsi"

/ {
	chosen {
		bootargs = "earlyprintk keep_bootcon console=ttyS0,115200 console=tty0 clk-vita-pervasive.buses_mask=0x5";

		framebuffer0: framebuffer@20000000 {
			compatible = "simple-framebuffer";
			reg = <0x20000000 (1280*720*4)>;
		width = <1280>;
			height = <720>;
			stride = <(1280*4)>;
			format = "a8b8g8r8";
			status = "okay";
		};
	};
};

&i2c0 {
	status = "okay";
};

/* GPIO1 pin 3 is the external Type-A port's VBUS enable on this board. */
&gpio1 {
	status = "okay";
};

/* I2C1 has ADV7533 HDMI transmitter (0x38, 0x3D-0x3F) — disabled until
 * a driver is written. Also has motion sensor (0x0C) and LCD brightness (0x64). */

/* SDIF0 = eMMC, SDIF2 = WLAN/BT (SD8787 via SDIO) */
&sdif0 {
	status = "okay";
};

/* SDIF1 (game card) and SDIF3 (microSD/SD2Vita) disabled --
 * no cards present, and polling creates log spam */

&sdif2 {
	status = "okay";
};

/* USB host (EHCI-only; see the OHCI note in vita.dtsi).  Bus 0 is the
 * external Type-A port and bus 2 carries the internal Realtek 0bda:8152
 * USB-Ethernet adapter; both were identified on hardware in 2026-08.  No
 * attachment has been found on bus 1, which stays enabled only until that
 * is confirmed.
 */
&ehci0 {
	status = "okay";
};

/* The PSTV (Dolce) has no touch panel. Probing the syscon touchscreen
 * on it issues Ernie touch commands with no hardware behind them,
 * which wedges the console during boot (observed 2026-08-19, c17).
 */
&syscon_ts {
	status = "disabled";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

/ {
	/* The external Type-A socket is on Sony bus 0 (&ehci0).  It stays
	 * dead until both the Dolce 5 V rail and GPIO1 pin 3 are asserted,
	 * which this node's driver does once &ehci0 has finished probing.
	 */
	usb0_power: usb0-power {
		compatible = "vita,dolce-usb-power";
		vita,syscon = <&syscon>;
		vita,ehci = <&ehci0>;
		enable-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
	};
};
